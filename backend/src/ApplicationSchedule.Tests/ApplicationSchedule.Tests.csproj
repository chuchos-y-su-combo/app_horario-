<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Testing Frameworks -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.extensibility.execution" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>

  <!-- EntityFramework para testing con InMemory -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
  </ItemGroup>

  <!-- WebApplicationFactory -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
  </ItemGroup>

  <!-- Referencias a los proyectos -->
  <ItemGroup>
    <ProjectReference Include="..\ApplicationSchedule.Api\ApplicationSchedule.Api.csproj" />
    <ProjectReference Include="..\ApplicationSchedule.Application\ApplicationSchedule.Application.csproj" />
    <ProjectReference Include="..\ApplicationSchedule.Infrastructure\ApplicationSchedule.Infrastructure.csproj" />
    <ProjectReference Include="..\ApplicationSchedule.Domain\ApplicationSchedule.Domain.csproj" />
  </ItemGroup>

</Project>